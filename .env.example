ENVIRONMENT=dev
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
SUPERUSERS=[]
COMMAND_START=["/"]

# 行情/缓存
WEATHER_FIGHTER_BUCKET_BARS=1800
WEATHER_FIGHTER_BUCKET_REALTIME=300
WEATHER_FIGHTER_BUCKET_HOURLY=3600
WEATHER_FIGHTER_BUCKET_DAILY=10800
WEATHER_FIGHTER_STALE_SECONDS=21600
WEATHER_FIGHTER_HTTP_TIMEOUT=30
WEATHER_FIGHTER_RETRY_COUNT=3
WEATHER_FIGHTER_PRELOAD_SEASON_SERIES=true
WEATHER_FIGHTER_PRINCIPAL=10000
# 杠杆上限（玩家用「倍数 N」在 1~该值之间自选）
WEATHER_FIGHTER_LEVERAGE=100
WEATHER_FIGHTER_SAFETY_ENTRY_PCT=20
WEATHER_FIGHTER_SAFETY_GRANT_PCT=5
WEATHER_FIGHTER_SAFETY_TARGET_PCT=35
WEATHER_FIGHTER_CHART_BARS=96
WEATHER_FIGHTER_ENABLE_REGION=true

# 彩云实时/临近（M1 预留；留空则只使用 Open-Meteo）
WEATHER_FIGHTER_CAIYUN_TOKEN=

# 可选：自定义 Chromium（默认使用 Playwright 安装的浏览器）
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
PLAYWRIGHT_CHROMIUM_ARGS=--no-sandbox --disable-crashpad
